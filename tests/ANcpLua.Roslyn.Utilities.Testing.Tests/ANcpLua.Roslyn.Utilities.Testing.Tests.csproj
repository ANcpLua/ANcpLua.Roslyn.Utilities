<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>ANcpLua.Roslyn.Utilities.Testing.Tests</RootNamespace>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <OutputType>Exe</OutputType>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
        <NoWarn>$(NoWarn);CA1707;CA1861;CA2007;CA1812;IDE1006;CS1591</NoWarn>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="AwesomeAssertions"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference
            Include="..\..\src\ANcpLua.Roslyn.Utilities.Testing.Xunit\ANcpLua.Roslyn.Utilities.Testing.Xunit.csproj"/>
    </ItemGroup>

    <!-- The async helpers are source-package-only (#if !NETSTANDARD), so link them into this
         test assembly to exercise the same code modern consumers compile from contentFiles. -->
    <ItemGroup>
        <Compile Include="..\..\src\ANcpLua.Roslyn.Utilities\Async\ParallelAsyncExtensions.cs"
                 Link="SourcePackage\ParallelAsyncExtensions.cs"/>
        <Compile Include="..\..\src\ANcpLua.Roslyn.Utilities\Async\AsyncSequenceExtensions.cs"
                 Link="SourcePackage\AsyncSequenceExtensions.cs"/>
    </ItemGroup>

</Project>
