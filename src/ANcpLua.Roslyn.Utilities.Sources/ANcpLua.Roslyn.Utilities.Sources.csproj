<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>

        <IncludeBuildOutput>false</IncludeBuildOutput>
        <IncludeSymbols>false</IncludeSymbols>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
        <DevelopmentDependency>true</DevelopmentDependency>

        <PackageId>ANcpLua.Roslyn.Utilities.Sources</PackageId>
        <Description>Source-only Roslyn utilities for analyzers and generators. Embeds as internal types.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>roslyn;source-generator;source-only;analyzer</PackageTags>

        <IsPackable>true</IsPackable>
        <NoPackageAnalysis>true</NoPackageAnalysis>

        <ContentTargetFolders>contentFiles</ContentTargetFolders>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\"/>
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="build/*.props" Pack="true" PackagePath="build/"/>
        <None Include="build/*.targets" Pack="true" PackagePath="build/"/>
        <None Include="buildTransitive/*.props" Pack="true" PackagePath="buildTransitive/"/>
        <None Include="buildTransitive/*.targets" Pack="true" PackagePath="buildTransitive/"/>
    </ItemGroup>

    <!-- Rewrites the utilities to internal for the source-only package: collapses the
         ANCPLUA_ROSLYN_PUBLIC visibility guards, turns public types internal, and marks every
         file <auto-generated/> so consumer analyzers skip it. -->
    <UsingTask TaskName="TransformUtilitySources"
               TaskFactory="RoslynCodeTaskFactory"
               AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <SourceDir ParameterType="System.String" Required="true"/>
            <OutputDir ParameterType="System.String" Required="true"/>
        </ParameterGroup>
        <Task>
            <Using Namespace="System.IO"/>
            <Using Namespace="System.Linq"/>
            <Using Namespace="System.Text"/>
            <Using Namespace="System.Text.RegularExpressions"/>
            <Code Type="Fragment" Language="cs"><![CDATA[
var source = Path.GetFullPath(SourceDir).TrimEnd('/', '\\');
if (Directory.Exists(OutputDir)) Directory.Delete(OutputDir, true);
Directory.CreateDirectory(OutputDir);

var rewrites = new[]
{
    new[] { @"(?m)^#if ANCPLUA_ROSLYN_PUBLIC\r?\npublic\r?\n#else\r?\ninternal\r?\n#endif", "internal" },
    new[] { @"(?m)^#if ANCPLUA_ROSLYN_PUBLIC\r?\n#else\r?\ninternal\r?\n#endif\r?\n", "" },
    new[] { @"\bpublic\s+static\s+partial\s+class\b", "internal static partial class" },
    new[] { @"\bpublic\s+static\s+class\b", "internal static class" },
    new[] { @"\bpublic\s+readonly\s+record\s+struct\b", "internal readonly record struct" },
    new[] { @"\bpublic\s+readonly\s+struct\b", "internal readonly struct" },
    new[] { @"\bpublic\s+sealed\s+class\b", "internal sealed class" },
    new[] { @"\bpublic\s+abstract\s+class\b", "internal abstract class" },
    new[] { @"\bpublic\s+partial\s+class\b", "internal partial class" },
    new[] { @"\bpublic\s+class\b", "internal class" },
    new[] { @"\bpublic\s+record\s+struct\b", "internal record struct" },
    new[] { @"\bpublic\s+record\b", "internal record" },
    new[] { @"\bpublic\s+interface\b", "internal interface" },
    new[] { @"\bpublic\s+enum\b", "internal enum" },
    new[] { @"\bpublic\s+delegate\b", "internal delegate" },
};

var files = Directory.EnumerateFiles(source, "*", SearchOption.AllDirectories)
    .Where(f => f.EndsWith(".cs", StringComparison.Ordinal))
    .ToList();
var contents = files.ToDictionary(f => f, f => File.ReadAllText(f));

// A file depends on Roslyn when it names Microsoft.CodeAnalysis, or uses a type declared in such a file
// (to a fixpoint). Those files land under Roslyn/, so InjectRoslynSources=false can leave them out and a
// consumer without a Microsoft.CodeAnalysis reference still compiles the rest. Comments and string literals
// do not count, and neither does a member access or call that happens to share a type's name.
string Code(string text)
{
    var lines = text.Split('\n');
    for (var i = 0; i < lines.Length; i++)
    {
        var line = lines[i];
        if (line.TrimStart().StartsWith("//", StringComparison.Ordinal)) { lines[i] = ""; continue; }
        line = Regex.Replace(line, "\\$?@?\"(?:[^\"\\\\]|\\\\.)*\"", "\"\"");
        var comment = line.IndexOf("//", StringComparison.Ordinal);
        lines[i] = comment >= 0 ? line.Substring(0, comment) : line;
    }
    return Regex.Replace(string.Join("\n", lines), @"/\*.*?\*/", "", RegexOptions.Singleline);
}
var code = files.ToDictionary(f => f, f => Code(contents[f]));
var roslyn = new HashSet<string>(files.Where(f => code[f].Contains("Microsoft.CodeAnalysis")));
var declaration = new Regex(@"\b(?:class|struct|record|interface|enum|delegate)\s+(?:struct\s+|class\s+)?([A-Z]\w*)", RegexOptions.Compiled);
for (var grown = true; grown;)
{
    grown = false;
    var roslynTypes = new HashSet<string>(roslyn.SelectMany(f => declaration.Matches(code[f]).Cast<Match>().Select(m => m.Groups[1].Value)));
    foreach (var file in files.Where(f => !roslyn.Contains(f)))
    {
        var usages = declaration.Replace(code[file], "");
        if (roslynTypes.Any(type => Regex.IsMatch(usages, @"(?<![\w.])" + type + @"\b(?!\s*\()")))
        {
            roslyn.Add(file);
            grown = true;
        }
    }
}

foreach (var file in files)
{
    var content = contents[file];
    foreach (var rewrite in rewrites)
        content = Regex.Replace(content, rewrite[0], rewrite[1]);

    var relative = file.Substring(source.Length + 1);
    var target = Path.Combine(OutputDir, roslyn.Contains(file) ? Path.Combine("Roslyn", relative) : relative);
    Directory.CreateDirectory(Path.GetDirectoryName(target));
    File.WriteAllText(target, "// <auto-generated/>\n#nullable enable\n" + content, new UTF8Encoding(false));
}

Log.LogMessage(MessageImportance.High, $"Transformed {files.Count} files to {OutputDir} ({roslyn.Count} under Roslyn/)");
]]></Code>
        </Task>
    </UsingTask>

    <Target Name="_TransformSourcesForPack" BeforeTargets="_GetPackageFiles">
        <PropertyGroup>
            <_TransformedDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'transformed'))</_TransformedDir>
        </PropertyGroup>

        <TransformUtilitySources SourceDir="$(MSBuildProjectDirectory)/../ANcpLua.Roslyn.Utilities"
                                 OutputDir="$(_TransformedDir)"/>

        <ItemGroup>
            <Content Remove="../ANcpLua.Roslyn.Utilities/**/*.cs"/>
            <Content Include="$(_TransformedDir)**/*.cs"
                     PackagePath="contentFiles/cs/any/ANcpLua.Roslyn.Utilities/"
                     Pack="true"
                     BuildAction="Compile"
                     CopyToOutput="false"
                     Flatten="false"
                     Visible="false"/>
        </ItemGroup>
    </Target>
</Project>
