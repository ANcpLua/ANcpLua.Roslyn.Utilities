<Project>
    <!--
        ANcpLua.Roslyn.Utilities.Polyfills - Source-only polyfills for netstandard2.0.
        All types are internal and #if-gated by target framework.
        No configuration needed - polyfills activate automatically based on TFM.
    -->
    <PropertyGroup>
        <!-- Read by ANcpLua.Roslyn.Utilities.Sources to drop its embedded copy of the same polyfills. -->
        <ANcpLuaRoslynUtilitiesPolyfillsImported>true</ANcpLuaRoslynUtilitiesPolyfillsImported>
    </PropertyGroup>
</Project>
